# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=*

# Database PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=fidelity_db
DB_SSL=false
DB_SYNCHRONIZE=false

# JWT Security
# En producción el servidor NO arranca con este valor de ejemplo ni con uno de menos de 32
# caracteres. Genera uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=super_secret_jwt_key_fidelity_2026_change_in_production
JWT_EXPIRES_IN=7d

# Firebase Cloud Messaging (FCM) Credentials
# Option 1: Inline JSON string
FIREBASE_SERVICE_ACCOUNT=
# Option 2: File path
FIREBASE_CREDENTIALS_PATH=

# Pagos del registro de negocios (PAGA YA)
# Precios por defecto; el administrador los cambia desde la app (Pagos → Precios)
REGISTRATION_FEE=20
BRANCH_FEE=10
PAYMENT_CURRENCY=USD
# Cuentas bancarias para transferencias y depósitos: lista en JSON, en una sola línea
# (sin cuentas no se ofrece el pago por transferencia). Ejemplo:
# BANK_ACCOUNTS=[{"name":"Banco","accountNumber":"1234567890","accountType":"Cuenta de ahorros","holder":"NOMBRE DEL TITULAR","taxId":"1234567890"}]
BANK_ACCOUNTS=
# Pago con tarjeta por PayPhone (botón por redirección). Token y Store ID salen de
# PayPhone Developers (app de tipo API; el Store ID es opcional). PUBLIC_API_URL es la dirección de este
# backend alcanzable desde el navegador del cliente (a ella vuelve PayPhone tras
# el pago). Sin los tres datos no se ofrece el pago con tarjeta.
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
PUBLIC_API_URL=

# Webhook Security
WEBHOOK_SECRET=fidelity_webhook_secure_secret_2026

# Correo saliente (código para recuperar la contraseña y aviso de cambio de clave).
# Con SMTP_HOST vacío el correo solo se escribe en el log del servidor (solo fuera
# de producción). Guía paso a paso: docs/correo.md. Para probarlo: npm run mail:test -- tu@correo.com
#
# Ejemplo con Gmail (cuenta con verificación en 2 pasos y "contraseña de aplicación"):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=tu@gmail.com
#   SMTP_PASS=<las 16 letras que te da Google; los espacios se ignoran>
# La conexión siempre va cifrada (587 = STARTTLS, 465 = TLS directo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente que ve la persona. Con Gmail debe usar la misma cuenta de SMTP_USER.
MAIL_FROM=Fidelity <tu@gmail.com>

# Límite de intentos (frena a quien prueba contraseñas): 10 inicios de sesión por
# minuto por IP y correo, 5 códigos de recuperación cada 10 minutos, etc.
# Detrás de un proxy o balanceador (Nginx, etc.) pon TRUST_PROXY=1 para ver la IP real.
TRUST_PROXY=
RATE_LIMIT_DISABLED=false

# Cuenta de administrador (npm run seed:admin). Todo es opcional: sin ADMIN_PASSWORD
# se genera una clave fuerte y se muestra una sola vez en pantalla.
ADMIN_EMAIL=admin@fidelity.com
ADMIN_NAME=Administrador Fidelity
ADMIN_PASSWORD=
